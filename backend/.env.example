# Copy this file to backend/.env and fill in real values. Never commit .env.

# AI provider: openai or anthropic. If omitted, existing setups use anthropic.
LLM_PROVIDER=openai

# OpenAI — required when LLM_PROVIDER=openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic — required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Semantic Scholar API — recommended
# Without a key: shared unauthenticated pool (unreliable for a demo).
# With a key: 1 request/sec on the standard tier.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API — optional
# https://openalex.org
OPENALEX_API_KEY=your_openalex_api_key_here

# Hugging Face API — optional
# https://huggingface.co
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# arXiv API — no key required (public). Max 1 request per 3 seconds per
# arXiv's terms of use; enforced by the rate-limit registry, not here.

# Local server port the extension calls (see docker-compose.yml)
PORT=8787

# Optional backend token — authenticates the extension to THIS backend
# (not to any AI/search provider). Leave unset to allow unauthenticated
# local development; if set, requests must send Authorization: Bearer <token>.
BACKEND_TOKEN=
