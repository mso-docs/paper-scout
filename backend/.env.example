# Copy this file to backend/.env and fill in real values. Never commit .env.

# Anthropic Claude API — required
# Used for evidence classification (supporting/conflicting) and summary generation.
# https://platform.claude.com
ANTHROPIC_API_KEY=

# Semantic Scholar API — recommended
# Without a key: shared unauthenticated pool (unreliable for a demo).
# With a key: 1 request/sec on the standard tier.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API — optional
# https://openalex.org
OPENALEX_API_KEY=your_openalex_api_key_here

# Hugging Face API — optional
# https://huggingface.co
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# arXiv API — no key required (public). Max 1 request per 3 seconds per
# arXiv's terms of use; enforced by the rate-limit registry, not here.

# Local server port the extension calls (see docker-compose.yml)
PORT=8787
