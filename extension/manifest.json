{
  "manifest_version": 3,
  "name": "Paper Scout",
  "description": "Capture the current page heading as the foundation for paper chat and claim investigation.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Paper Scout — capture page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
